{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["chrome", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    
    "paths": {
      "@css/*": ["./res/css/*"],
      "@font/*": ["./res/font/*"],
    },
  },
  "include": [
    "entrypoints/**/*",
    ".wxt/**/*",
  ],
}
